{
    "dataRoles": [
        {
            "displayName": "Província (ID ou Nome)",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Valor (Métrica)",
            "name": "measure",
            "kind": "Measure"
        },
        {
            "displayName": "Dicas de Ferramenta (Tooltips)",
            "name": "tooltips",
            "kind": "Measure"
        }
    ],
    "objects": {
        "mapSettings": {
            "displayName": "Cores do Mapa",
            "properties": {
                "minColor": {
                    "displayName": "Cor Mínima",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "maxColor": {
                    "displayName": "Cor Máxima",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "emptyColor": {
                    "displayName": "Cor Sem Dados",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "borderColor": {
                    "displayName": "Cor da Borda",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "borderWidth": {
                    "displayName": "Espessura da Borda",
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "dataLabels": {
            "displayName": "Rótulos de Dados",
            "properties": {
                "show": {
                    "displayName": "Exibir Rótulos",
                    "type": {
                        "bool": true
                    }
                },
                "showValues": {
                    "displayName": "Exibir Valores",
                    "type": {
                        "bool": true
                    }
                },
                "color": {
                    "displayName": "Cor do Texto",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "fontSize": {
                    "displayName": "Tamanho da Fonte",
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "categorical": {
                "categories": {
                    "for": {
                        "in": "category"
                    },
                    "dataReductionAlgorithm": {
                        "top": {}
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "measure"
                            }
                        },
                        {
                            "bind": {
                                "to": "tooltips"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "supportsHighlight": true,
    "privileges": []
}
